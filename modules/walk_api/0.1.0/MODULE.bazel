module(
    name = "walk_api",
    version = "0.1.0",
    compatibility_level = 1,
)

# walk_api is the contract root of the walk-and-record platform: the wire
# formats for describing a target (walk.surface.v1), becoming a person on it
# (walk.identity.v1), planning a walk (walk.plan.v1), running it (walk.run.v1),
# what it produced (walk.record.v1, walk.evidence.v1) and what gets rendered
# from that (walk.projection.v1, walk.docs.v1), plus the agent drafting surface
# (walk.compose.v1).
#
# THE DIRECTION OF DEPENDENCY IS THE WHOLE POINT. Every engine, every adapter
# and every projection depends on this module; this module depends on none of
# them. That is not tidiness — it is the property that makes the seams real. An
# `aion.module` surface adapter and an OpenAPI surface adapter can ship on their
# own schedules precisely because neither is named here, and a new projection is
# a new consumer rather than a release of the engine. The moment this module
# grows a dependency pointing back at an implementation, the arrow is a cycle
# and every "independent" deployable is one release train again.
#
# No implementation lives here, and no language bindings either: a Rust engine,
# a TypeScript MCP composer and a Go projection each generate their own from
# these files (or from //proto:walk_descriptor_set). Taking on codegen for every
# consumer's language would make this module depend on their toolchains, which
# is the same arrow inverted.
#
# Lifted from aion/e2e + aion/docs, with the two product couplings promoted to
# interfaces (walk.surface.v1, walk.identity.v1). SEAMS.md is the argument.
#
# compatibility_level 1 covers the `walk.*` packages as published. Bumping it
# means a consumer cannot link the old and new module in one build — reserve it
# for a wire-incompatible change, which for a contracts module means a package
# rename or a field-number reuse, not a new message.

# AIP tooling: aip_proto_library + the api-linter gate.
bazel_dep(name = "rules_aip", version = "0.3.0")
bazel_dep(name = "protobuf", version = "29.0")

# proto_library + proto_descriptor_set, for //proto:walk_protos and
# //proto:walk_descriptor_set. 7.1.0 is a floor and the API is checked against
# it: proto_descriptor_set is re-exported from @rules_proto//proto:defs.bzl and
# concatenates transitive descriptor sets — see the note in proto/BUILD.bazel,
# it does NOT shell out to protoc.
bazel_dep(name = "rules_proto", version = "7.1.0")

# google.api.{field_behavior,resource} annotations — not vendored.
bazel_dep(name = "googleapis", version = "0.0.0-20260422-20ac242a")

# NO C++ TOOLCHAIN, and none is needed.
#
# There was one here — toolchains_llvm — for a single reason: rules_aip named
# `@protobuf//:protoc` directly, which is the from-source cc_binary, so linting
# protos dragged a compiler into a repo containing no C++. That cost three failed
# CI builds and reproduced both halves of the LLVM bind aion/e2e has been stuck in
# (18.1.8 cannot load libtinfo.so.5; 20.1.3 will not fit on a runner).
#
# Fixed upstream in rules_aip 0.3.0, which resolves the proto toolchain instead.
# The block is deleted rather than pinned, and that is the difference between
# fixing a problem and choosing which environment it breaks in.

"""rules_aion — shared Bazel rules for the aion + studio workspaces.

Consolidates the TS-packaging, vitest, db-codegen, migrations-bundle and
bundler rules that were copy-pasted across aion/lift, platform/studio (and
their siblings). Consumers load each rule from `@rules_aion//<rule>:defs.bzl`
and supply their own repo-local drivers/configs/toolchains via attrs, so the
rule logic lives in exactly one place.

Hosted at gitlab.savvifi.com:aion/rules; consumed via `local_path_override`
in the savvi meta-workspace today (a savvifi Bazel registry can follow).
"""

module(
    name = "rules_aion",
    version = "0.7.2",
)

# ─── Runtime deps the rules load from ─────────────────────────────────────────
# Non-dev: a consumer that loads e.g. `@rules_aion//ts_package:defs.bzl`
# transitively needs these so the `load("@aspect_rules_js//…")` inside resolve.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# proto_descriptor_set (//proto) -- ProtoInfo comes from rules_proto, and the
# proto TOOLCHAIN TYPE it resolves protoc through is protobuf's. Versions track
# the consuming repo so the resolved graph does not fork.
bazel_dep(name = "rules_helm", version = "0.1.0")  # savvi_helm_chart (//helm)

# savvi_operator_image (//operator): the pkg_tar → oci_image/load/push chain four
# operators had copy-pasted. Versions match the root workspace so the resolved graph
# does not fork. rules_go is deliberately absent — see the note in operator/defs.bzl.
bazel_dep(name = "rules_oci", version = "2.2.6")

# 1.0.1, NOT the root workspace's 1.2.0, and the difference is the point.
#
# A LIBRARY declares the MINIMUM it needs and lets MVS raise it; matching a
# consumer's pin is what a root module does. This module uses rules_pkg for
# exactly one symbol — `pkg_tar` in operator/defs.bzl — which 1.0.1 has, so
# aion's own graph still resolves 1.2.0 (MVS takes the max) and nothing forks
# there either way.
#
# Declaring 1.2.0 here forked the REGISTRY instead. 23 registered modules pin
# rules_pkg 1.0.1; publishing one at 1.2.0 made rules_aion the only dissenter,
# and registry conformance C1 — "one live version per third-party atom" —
# went 29 -> 30 and failed the 0.7.1 registration PR. C1 compares MVS results
# across every module graph in the registry, and its own header explains the
# stakes: since Bazel 8.6.0/9.1.0 `compatibility_level` is a no-op, so MVS will
# silently upgrade a consumer across a breaking change and Bazel cannot object.
# One version per atom is the only thing standing in the way.
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "34.0.bcr.1")
bazel_dep(name = "aspect_rules_js", version = "3.1.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.9")
bazel_dep(name = "aspect_rules_esbuild", version = "0.26.0")  # esbuild_bundle
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # copy_to_bin (esbuild shim)

# fastverk/* registry modules (resolved via the fastverk registry in .bazelrc):
#   rules_vite — vitest_test wraps `@rules_vite//vite:defs.bzl`
# (Generic Bun bundling lives in fastverk/rules_bun, not here.)
bazel_dep(name = "rules_vite", version = "0.1.0")

# CI generation (//aion_project) — the generic fastverk layer. `aion_framework_library`
# wraps `@rules_ci//project:defs.bzl`'s `fastverk_project` (which composes rules_gitlab's
# `gitlab_ci` + the release_artifacts aspect). rules_gitlab 0.3.3 (validate python-3.12
# pin) is declared directly so MVS selects it over rules_ci's transitive floor.
bazel_dep(name = "rules_ci", version = "0.0.3")
bazel_dep(name = "rules_gitlab", version = "0.3.4")

# The aion_project validate lane runs rules_gitlab's check-jsonschema, whose
# transitive rpds-py has a cp312 native ext — so the validate py_binary
# (python_version=3.12) needs a 3.12 interpreter. rules_python only honors that
# versioned pin against a toolchain registered in the ROOT module's set; rules_gitlab
# registers 3.12 as available (non-default), which a versioned pin doesn't pick up
# transitively. Register 3.12 here (default) so the pin resolves + validate runs 3.12.
bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12", is_default = True)

# aion_deploy's ArgoCD-Application emitter (//aion_deploy/private:emit) needs ruamel.yaml for
# round-trip YAML with comments (§6.2 of AION-GENERATED-ARGO-DESIGN.md). A small dedicated pip
# hub, mirroring how rules_gitlab supplies ruamel to its own emitter. Pinned to the 3.12
# interpreter registered above.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "aion_deploy_pip",
    python_version = "3.12",
    requirements_lock = "//aion_deploy/private:requirements.txt",
)
use_repo(pip, "aion_deploy_pip")

# k8s_validate for the generated Application (schema gate, §6.1/§6.5). rules_k8s pulls
# rules_go/gazelle transitively (its crd2jsonschema tool is Go); registered at bazel-registry
# a01d27e (the .bazelrc pin above was bumped in the same change — 65d9897 predates it).
bazel_dep(name = "rules_k8s", version = "0.0.3")

# ─── Dev-only (docs + smoke lint) ─────────────────────────────────────────────
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.7.2", dev_dependency = True)

# README generation (//:readme) — rules_readme from the fastverk registry.
bazel_dep(name = "rules_readme", version = "0.0.3")

# ── C++ toolchain: hermetic LLVM 20, not the image's gcc ─────────────────────
#
# This repo needs a cc toolchain for ANALYSIS, not for compiling any C++ of its
# own: rules_k8s' bundle depends on @rules_cc's local_config_cc, and bazel_tools'
# launcher_maker resolves @bazel_tools//tools/cpp:toolchain_type. Without one,
# analysis fails before a single target is built.
#
# Its GitLab lane never noticed because gcr.io/bazel-public/bazel ships gcc, so
# autodetection found one. The fastverk build-runner image does not, which is why
# every rail build of this repo has failed — first with
#
#   No matching toolchains found for @@bazel_tools//tools/cpp:toolchain_type
#
# and then, once autodetection was re-enabled, with
#
#   Auto-Configuration Error: Cannot find gcc or CC
#
# Registering a HERMETIC toolchain fixes both, and removes the dependency on
# whatever compiler the CI image happens to carry — the same reason the rest of
# the fleet pins it (aion/graph, aion/deploy, aion/idp all on 1.8.0 / 20.1.3).
# toolchains_llvm 1.8.0 raised MAX_VERSION to 20.1.3.
#
# No rules_rust here, so aion/deploy's companion
# `--@rules_rust//cargo/settings:experimental_symlink_execroot=True` is neither
# needed nor valid.
#
# dev_dependency ON ALL FOUR — this toolchain is for BUILDING rules_aion, never
# for consuming it. toolchains_llvm's extension fails outright when a non-root
# module uses it:
#
#   Error in fail: Only the root module can use the 'llvm' extension
#
# so without these flags the first release cut from this branch is unusable as a
# `bazel_dep` for every consumer — aion/graph, aion/lift, studio/app — and the
# failure is at module resolution, before any target is even analyzed. Consumers
# register their own hermetic LLVM (aion/graph's MODULE.bazel does exactly this),
# which is correct: the toolchain belongs to whoever is the root.
bazel_dep(name = "toolchains_llvm", version = "1.8.0", dev_dependency = True)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(llvm_version = "20.1.3")
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)
